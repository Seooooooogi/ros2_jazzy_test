# shellcheck shell=bash
# dev override(docker-compose.dev.yml)가 이 파일을 컨테이너의 /root/.bashrc 로 mount 한다.
# `docker exec -it <svc> bash` 진입 시 ROS overlay 를 자동 source 한다.
# 이유: entrypoint.sh 는 PID1(sleep) 전용이라 그 export 가 docker exec 로 띄운 새 셸엔 안 실린다.
# colcon build / ros2 run 을 바로 칠 수 있게 진입 시점에 환경을 갖춰 둔다.

# ROS setup.bash 는 unset 변수(AMENT_TRACE_SETUP_FILES 등)를 참조하므로 -u 해제 상태로 source.
set +u
# shellcheck source=/dev/null
source "/opt/ros/${ROS_DISTRO}/setup.bash"
# overlay — 최초엔 없을 수 있고(빌드 전), colcon build 후 생긴다.
# shellcheck source=/dev/null
[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash
# pip 패키지(torch/ultralytics 등)는 /usr/local/lib/python3.X/dist-packages = system python 기본
# sys.path 에 있으므로 PYTHONPATH 주입이 필요 없다.

# exec 진입 시 워크스페이스(/ws — host ~/*_ws/src 가 /ws/src 로 mount)로 이동.
# colcon build --symlink-install / ros2 run 을 추가 cd 없이 바로 실행할 수 있게 한다.
cd /ws 2>/dev/null || true
