# ros2_jazzy_test — Environment variables template
#
# 이 템플릿은 인스톨러가 자동 생성/로드하지 않는다. 필요한 변수만 골라 쓴다.
# 컨테이너 publish 변수(DOCKERHUB_*/YOLO_TAG)는 레포 루트 `.env` 로 복사해 docker-compose
# interpolation 에만 사용(기본 학습 경로 build-all.sh 는 안 읽음).
#
# 스크립트에서 로드 패턴:
#   set -a; source .env; set +a
#
# ⚠ OPENAI_API_KEY 는 여기서 다루지 않는다 — voice_processing 노드가 자기 패키지 resource/.env
#   (colcon 빌드 내장)를 직접 읽으므로, 사용자가 별도 안내에 따라 그 위치에 직접 배치한다.

# === Phase 4 컨테이너 (containers/build-all.sh / docker-compose.yml) ===
# DOCKERHUB_USER=            # 이미지 네임스페이스 (docker.io/<USER>/ros2-jazzy-yolo 등). build-all.sh 도 사용.
# DOCKERHUB_TOKEN=           # docker login 용 access token (publish 시, push 단계 host)
# YOLO_TAG 은 수동 docker-compose.yml publish(runtime) 빌드에만 적용된다(voice 는 컨테이너 아님 — host 실행).
# 학습 기본 경로(build-all.sh)는 :dev-builder 태그 고정이라 아래 값을 읽지 않는다.
# YOLO_TAG=v0.1.0            # latest 금지 — semver / git SHA 만
# CUDA_VERSION=12.8          # yolo 이미지 build-arg (pip cu128). 기본값은 resources/config.sh
# ROS_DOMAIN_ID=             # host ↔ 컨테이너 DDS discovery 동일 도메인. 설치는 prompt/주입 안 함 — 학생이
#                            # 직접 ~/.bashrc 에 `export ROS_DOMAIN_ID=<n>` 삽입(학습). 미설정 시 host·컨테이너 모두 0(ROS2 기본).
#                            # 여기(env)에 값을 주면 그 세션 최우선 — host·양 컨테이너 동일해야 함(다르면 조용한 discovery 실패).

# === corecode 튜토리얼 (선택 — OD 데이터셋 다운로드 노트북) ===
# ROBOFLOW_API_KEY=          # ~/corecode/OD_Tutorial/YOLO/data_download.ipynb 의 Roboflow 다운로드용.
#                            # 설치/런타임과 무관 — 그 노트북을 직접 실행할 때만 환경에 export.

# === Installer Config ===
# ROS_DISTRO=jazzy
# UBUNTU_CODENAME=noble
# INSTALL_STATE_FILE=$HOME/.ros2_jazzy_test/state
