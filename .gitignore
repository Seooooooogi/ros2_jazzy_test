# Environment
.env
.env.local
# .env 키 기록 시 만드는 임시파일(.env.XXXXXX) 등 모든 .env 파생물 — 단 템플릿은 추적
.env.*
!.env.example

# Installer state / checkpoint — 머신별 진행 상태라 재생성 가능, 추적하지 않음
.install_state
*.state
/state/

# Logs (append-only, but not committed)
*.log
install.log
*.jsonl
# install.sh 상세 로그 — 레포 루트에 쌓이는 머신별 append-only 로그(재생성 가능). 루트만 anchor.
/install_log

# Downloaded artifacts / intermediate
*.deb
*.run
*.tar.gz
*.tgz
*.zip

# Python (Voice 단계 잔여물)
__pycache__/
*.pyc
*.pyo
venv/
.venv/

# IDE
.vscode/
.idea/
*.swp
*~

# Jupyter checkpoint shadow
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# 설치 스크립트와 무관한 작업 데이터 — 추적/배포 대상 아님.
# claude-migration: 세션 transcript(.jsonl) 등 민감 데이터 포함.
claude-migration/

# corecode: 개발/연구용 튜토리얼 — 소스만 추적. 아래 둘만 제외(__pycache__·*.pyc 는 위 Python 규칙으로 이미 제외).
# tflite: containers oww_models 와 중복. json: 대용량 재생성 가능 임베딩.
corecode/VoiceProcessing/hello_rokey_8332_32.tflite
corecode/VoiceProcessing/class_embeddings.json

# jog 편의 복사본 — 실기 jog 검증을 최상위 경로로 실행하려고 둔 로컬 파일. 디스크엔 남기되 추적만 제외.
/jog_complete.py

# codegraph 코드 인덱스 — 소스에서 재생성 가능한 산출물이라 추적 제외.
.codegraph/

# cobot2 애플리케이션 소스는 이 레포에서 제공하지 않는다 — 사용자가 ~/cobot_ws/src/cobot2 에 직접 배치(setup-app.sh 가 빌드).
# repo 안 cobot_ws/src/ 에 소스를 두고 빌드(컨테이너 --build 등)하더라도 추적하지 않는다.
/cobot_ws/src/
# colcon 빌드 산출물 — repo 안에서 빌드를 돌리면 생기는 재생성 가능 디렉토리.
/log/
cobot_ws/build/
cobot_ws/install/
cobot_ws/log/

# 브레인스토밍/스펙 설계 산출물 (로컬 작업물 — 배포 대상 아님)
docs/superpowers/

# 로컬 에이전트/분석 도구 산출물 — 소스에서 재생성 가능, 배포 대상 아님.
.agents/
.understand-anything/

# Skill 매니저가 설치/관리하는 패키지 + lock — 재설치로 재생성 가능, 로컬 환경 전용.
.claude/skills/
skills-lock.json

# 로컬 참조용 wiki 덤프 — 설치 스크립트/배포와 무관(humble 보존 스크립트는 backup/ 안에서 계속 추적).
backup/llm_wiki/

# subagent-driven-development 진행 ledger (scratch — 추적 안 함)
.superpowers/
